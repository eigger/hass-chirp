    "step": {
      "init": {
        "title": "Chirp options",
        "description": "Choose how often Home Assistant polls Chirp. Select the sensor groups to add. You can change these later in Configure or Reconfigure. This controls Home Assistant entities; server-side collection is configured on Chirp.",
