{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Chirp",
        "description": "Enter the address and port of your Chirp server and an API key. The key starts with chp_. Find it in the Chirp dashboard under Settings → API key, or run key show on the Chirp server (see the documentation). Select the sensor groups to add. You can change these later in Configure or Reconfigure. This controls Home Assistant entities; server-side collection is configured on Chirp.",
        "data": {
          "host": "Host",
          "port": "Port",
          "api_key": "API key",
          "ssl": "Use HTTPS",
          "verify_ssl": "Verify SSL certificate",
          "monitor_cpu": "CPU",
          "monitor_ram": "RAM and swap",
          "monitor_smart": "Disks and SMART",
          "monitor_network": "Network",
          "monitor_hardware": "Hardware temperature, power, fans and voltage",
          "monitor_storage": "Filesystems and ZFS"
        },
        "data_description": {
          "host": "IP address or host name of the Chirp server, without http:// or a path.",
          "port": "Chirp listens on port 80 by default.",
          "api_key": "The Chirp API key (starts with chp_). Find it in the Chirp dashboard under Settings → API key, or run key show on the Chirp server (see the documentation).",
          "ssl": "Enable only when Chirp is served over HTTPS, for example behind a reverse proxy.",
          "verify_ssl": "Turn off only for a self-signed certificate on a server you trust. Applies only with HTTPS."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Chirp",
        "description": "The Chirp server rejected the stored API key. Enter a new API key for this server.",
        "data": {
          "api_key": "API key"
        },
        "data_description": {
          "api_key": "The Chirp API key (starts with chp_). Find it in the Chirp dashboard under Settings → API key, or run key show on the Chirp server (see the documentation)."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Chirp",
        "description": "Change the address of this Chirp server. The stored API key is reused and the server must be the same instance. Select the sensor groups to add. You can change these later in Configure or Reconfigure. This controls Home Assistant entities; server-side collection is configured on Chirp.",
        "data": {
          "host": "Host",
          "port": "Port",
          "ssl": "Use HTTPS",
          "verify_ssl": "Verify SSL certificate",
          "monitor_cpu": "CPU",
          "monitor_ram": "RAM and swap",
          "monitor_smart": "Disks and SMART",
          "monitor_network": "Network",
          "monitor_hardware": "Hardware temperature, power, fans and voltage",
          "monitor_storage": "Filesystems and ZFS"
        },
        "data_description": {
          "host": "IP address or host name of the Chirp server, without http:// or a path.",
          "port": "Chirp listens on port 80 by default.",
          "ssl": "Enable only when Chirp is served over HTTPS, for example behind a reverse proxy.",
          "verify_ssl": "Turn off only for a self-signed certificate on a server you trust. Applies only with HTTPS."
        }
      }
    },
    "error": {
      "invalid_auth": "The API key was rejected by Chirp.",
      "cannot_connect": "Cannot connect to Chirp, or its response is invalid. Check the host, port and HTTPS setting.",
      "invalid_host": "Enter only a host name or IP address, without http:// or a path.",
      "wrong_instance": "This API key or address belongs to a different Chirp instance.",
      "unknown": "Unexpected error. Check the Home Assistant logs."
    },
    "abort": {
      "already_configured": "This Chirp instance is already configured. Its address and API key were updated.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration was successful.",
      "wrong_instance": "The server at this address is a different Chirp instance."
    }
  },
